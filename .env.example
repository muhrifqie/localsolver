# --- server ---
HOST=127.0.0.1
PORT=5033

# --- browser pool ---
# HEADLESS=false to watch the browser while debugging a site
HEADLESS=true
THREAD=1            # browser contexts (concurrency = THREAD x PAGE_COUNT)
PAGE_COUNT=1        # pages per context
CLEANUP_INTERVAL_MINUTES=60

# --- proxy (optional) ---
PROXY_SUPPORT=false
PROXY_FILE=proxies.txt   # lines: scheme://ip:port or scheme://ip:port:user:pass

# --- task limits ---
SOLVE_TIMEOUT=60    # per-task hard cap (seconds)
RESULT_TTL=300      # keep a finished result this long for /result polling

# --- paid-API fallback (optional, local-first) ---
# Only used when a LOCAL solve fails. Leave disabled to stay 100% free/local.
FALLBACK_ENABLED=false
CAPSOLVER_API_KEY=
CAPSOLVER_API=https://api.capsolver.com

# --- logging ---
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=7 days
